FROM python:3.11.18-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY requirements-research.lock /app/
RUN pip install --no-cache-dir -r requirements-research.lock
COPY . /app
RUN useradd --create-home --uid 10001 researcher && mkdir -p /app/data && chown researcher /app/data
USER researcher
CMD ["python", "run_research.py", "plan"]
